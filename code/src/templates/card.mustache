<div class="col-sm-3" id={{cryptoId}}>
    <div class="card" id={{cryptoId}}>
        <img src={{source}} alt={{cryptoName}} id={{cryptoId}}/>
        <div class="caption" id={{cryptoId}}>
            <h3 id={{cryptoId}}>{{cryptoName}}</h3>
            <p id={{cryptoId}}>Symbole: {{cryptoSymbol}}</p>
        </div>
        <button type="button" class="btn btn-success voir-plus" id={{cryptoId}} role="button" data-bs-toggle="modal" data-bs-target="#main_modal">Voir plus</button>
    </div>
</div>