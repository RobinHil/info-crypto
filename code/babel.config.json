{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "browsers": "> .5% or last 3 versions"
        },
        "modules": false
      }
    ]
  ],
  "plugins": [
    [
      "polyfill-corejs3",
      {
        "method": "usage-global",
        "version": "3.50.0"
      }
    ]
  ]
}
